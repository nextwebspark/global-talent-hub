# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Supabase ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string — use the Transaction mode pooler URL (port 6543)
# Dashboard → Project Settings → Database → Connection string → Transaction
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase project URL and anon/service key
# Dashboard → Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_KEY=

# Required for Supabase SSL (uses self-signed certs)
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# ── Google Vertex AI (all LLM calls) ─────────────────────────────────────────

# Routes calls through Vertex AI instead of Google AI Studio
GOOGLE_GENAI_USE_VERTEXAI=true

# Your Google Cloud project ID
GOOGLE_CLOUD_PROJECT=hak-talent-mapping

# Region where Vertex AI models are deployed
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini model for enrichment/discovery
ENRICHMENT_MODEL=gemini-2.5-pro

# ── Required: Search & Map ────────────────────────────────────────────────────

# Serper API — Google Search for the discovery pipeline
# Get at https://serper.dev
SERPER_API_KEY=

# Mapbox — interactive globe/map
# Get at https://account.mapbox.com/access-tokens
MAPBOX_ACCESS_TOKEN=

# ── Optional: Clockwork CRM Integration ──────────────────────────────────────

CLOCKWORK_API_KEY=
CLOCKWORK_API_SECRET=
CLOCKWORK_FIRM_KEY=
# Defaults to CLOCKWORK_FIRM_KEY if not set
CLOCKWORK_FIRM_SLUG=
# Defaults to https://api.clockworkrecruiting.com/v3.0
CLOCKWORK_API_URL=

# ── Server ────────────────────────────────────────────────────────────────────

# Set to "production" in prod — controls SSL, static serving, logging
NODE_ENV=development

# Port the server listens on (default: 5000)
PORT=5000
